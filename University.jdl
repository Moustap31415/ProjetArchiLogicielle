application {
  config {
    baseName Gateway
    applicationType gateway
    packageName sn.edu.ugb
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    clientPackageManager npm
  }
  entities *
}

application {
  config {
    baseName userService
    applicationType microservice
    packageName sn.edu.ugb.user
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    serverPort 8081
  }
  entities Role, ProfilUtilisateur
}

entity ProfilUtilisateur {
    nom String required
    prenom String required
    email String required unique
    telephone String
}

entity Role {
    nom String required
    description String
}

relationship OneToMany {
  Role{utilisateurs} to ProfilUtilisateur{role required}
}

application {
  config {
    baseName studentService
    applicationType microservice
    packageName sn.edu.ugb.student
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    serverPort 8082
  }
  entities Etudiant, HistoriqueAcademique, Inscription
}

entity Etudiant {
    numeroEtudiant String required unique pattern(/P[0-9]+/)
    dateNaissance LocalDate
    adresse String
    formationActuelle String
    utilisateurId Long required
}

entity HistoriqueAcademique {
    statut StatutAcademique required
    dateInscription Instant required
    semestreId Long
}

entity Inscription {
    enCours Boolean required
    dateInscription Instant required
    filiereId Long
    semestreId Long
}

relationship OneToMany {
  Etudiant{historiques} to HistoriqueAcademique{etudiant required},
  Etudiant{inscriptions} to Inscription{etudiant required}
}

application {
  config {
    baseName teacherService
    applicationType microservice
    packageName sn.edu.ugb.teacher
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    serverPort 8083
  }
  entities Enseignant, AffectationEnseignement
}

entity Enseignant {
    numeroEnseignant String required unique pattern(/E[0-9]+/)
    specialisation String
    dateEmbauche LocalDate
    utilisateurId Long required
}

entity AffectationEnseignement {
    anneeAcademique String required
    chargeHoraire Integer required
    coursId Long
}

relationship OneToMany {
  Enseignant{affectations} to AffectationEnseignement{enseignant required}
}

application {
  config {
    baseName cursusService
    applicationType microservice
    packageName sn.edu.ugb.curriculum
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    serverPort 8084
  }
  entities Filiere, Semestre, UniteEnseignement, Matiere, Curriculum
}

entity Filiere {
    nom String required
    code String required unique
    creditsTotaux Integer
}

entity Semestre {
    nom NomSemestre required
    dateDebut LocalDate required
    dateFin LocalDate required
}

entity UniteEnseignement {
    nom String required
    code String required unique
    credits Integer
    filiereId Long required
}

entity Matiere {
    nom String required
    heures Integer required
    credits Integer required
    uniteId Long required
}

entity Curriculum {
    anneeAcademique String required
    filiereId Long required
    uniteId Long required
    semestreId Long required
}

relationship OneToMany {
  Filiere{unites} to UniteEnseignement{filiere required},
  UniteEnseignement{matieres} to Matiere{unite required},
  Semestre{curriculums} to Curriculum{semestre required}
}

relationship ManyToOne {
  Curriculum{filiere} to Filiere,
  Curriculum{unite} to UniteEnseignement
}

application {
  config {
    baseName noteService
    applicationType microservice
    packageName sn.edu.ugb.grade
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    serverPort 8085
  }
  entities SessionExamen, Evaluation, Note
}

entity SessionExamen {
    nom String required
    dateDebut LocalDate required
    dateFin LocalDate required
}

entity Evaluation {
    type TypeEvaluation required
    noteMaximale Float required
    date LocalDate required
    coefficient Float required
    coursId Long
    sessionId Long required
}

entity Note {
    valeur Float required
    commentaires String
    dateSaisie Instant required
    etudiantId Long
    evaluationId Long required
}

relationship OneToMany {
  SessionExamen{evaluations} to Evaluation{session required},
  Evaluation{notes} to Note{evaluation required}
}

application {
  config {
    baseName reportingService
    applicationType microservice
    packageName sn.edu.ugb.reporting
    authenticationType oauth2
    serviceDiscoveryType eureka
    skipClient true
    prodDatabaseType postgresql
    buildTool maven
    serverPort 8086
  }
  entities ModeleRapport, DonneeStatistique, DonneeModele
}

entity ModeleRapport {
    nom String required
    requeteSql Text
}

entity DonneeStatistique {
    nom String required
    valeur Float required
    dateCalcul Instant required
    semestreId Long
    filiereId Long
}

entity DonneeModele {
    parametres String
}

relationship OneToMany {
  ModeleRapport{donnees} to DonneeModele{modele required}
}

relationship ManyToOne {
  DonneeModele{donnee} to DonneeStatistique
}

enum StatutAcademique {
    EN_COURS, VALIDE, ABANDON, REDOUBLE
}

enum TypeEvaluation {
    DS, EXAMEN, DM, PROJET, TP
}

enum NomSemestre {
    Semestre1, Semestre2
}

microservice ProfilUtilisateur, Role with userService
microservice Etudiant, HistoriqueAcademique, Inscription with studentService
microservice Enseignant, AffectationEnseignement with teacherService
microservice Filiere, Semestre, UniteEnseignement, Matiere, Curriculum with cursusService
microservice SessionExamen, Evaluation, Note with noteService
microservice ModeleRapport, DonneeStatistique, DonneeModele with reportingService

dto * with mapstruct
service * with serviceClass
paginate * with pagination except Note, DonneeModele